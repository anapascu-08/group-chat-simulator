# Copiază acest fișier în .env și ajustează după nevoie.

# Modelul Ollama folosit pentru toate personas.
OLLAMA_MODEL=gemma3:270m

# Unde ascultă Ollama local.
OLLAMA_HOST=http://localhost:11434

# Delay simulat între răspunsurile personas, în secunde.
# Implicit (fără .env) e scurt, potrivit pentru dezvoltare: 2-8 secunde.
# Pentru demo (vibe de grup chat real, conform SPEC.md), decomentează:
# RESPONSE_DELAY_MIN_S=120
# RESPONSE_DELAY_MAX_S=480
